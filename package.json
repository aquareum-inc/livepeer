{
  "name": "livepeer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @livepeer/web dev",
    "build": "pnpm --filter @livepeer/web build",
    "start": "pnpm --filter @livepeer/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @livepeer/db generate",
    "db:migrate": "pnpm --filter @livepeer/db migrate",
    "api:openapi": "pnpm --filter @livepeer/mobile-codegen openapi",
    "mobile:generate": "pnpm --filter @livepeer/mobile-codegen generate"
  }
}
