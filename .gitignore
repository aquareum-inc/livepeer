# secrets: every .env file, anywhere, except the committed example
.env*
!.env.example

# the operator's own config, written by `./livepeer setup` (presets and the mobile dev config live elsewhere)
/instance.config.json

# the instance's own state in development (device sessions)
.data/

# dependencies and build output
node_modules/
.next/
dist/
out/
coverage/
*.tsbuildinfo
.turbo/

# local reference clones and tooling
.reference/
.claude/
.DS_Store
playwright-report/
test-results/
next-env.d.ts

# logs
*.log

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
*.xcresult

# app signing and store uploads: never committed
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.ipa
*.apk
*.aab

# A Firebase project's config file. The Android app doesn't use it: the instance names its project at run time
# (mobile.android.firebase). It is only where those four values are copied from.
google-services.json
